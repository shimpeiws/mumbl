{
  "name": "mumbl",
  "version": "1.0.0",
  "description": "A terminal journaling app where AI just listens - powered by Ollama for fully local, private LLM processing",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mumbl": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "ci:check": "biome ci src/",
    "test": "vitest",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run test/integration/",
    "test:e2e": "vitest run test/e2e/",
    "test:coverage": "vitest run --coverage",
    "ci:test": "vitest run --coverage --reporter=verbose",
    "ci:all": "pnpm type-check && pnpm ci:check && pnpm ci:test"
  },
  "keywords": [
    "journal",
    "journaling",
    "tui",
    "terminal",
    "ollama",
    "llm",
    "ai",
    "cli",
    "ink",
    "react"
  ],
  "author": "shimpeiws",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimpeiws/mumbl.git"
  },
  "bugs": {
    "url": "https://github.com/shimpeiws/mumbl/issues"
  },
  "homepage": "https://github.com/shimpeiws/mumbl#readme",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "memfs": "^4.15.0",
    "msw": "^2.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.18",
    "@langchain/ollama": "^1.2.2",
    "better-sqlite3": "^12.6.2",
    "ink": "^6.6.0",
    "ollama": "^0.6.3",
    "react": "^19.2.4",
    "stopwords-iso": "^1.1.0",
    "string-width": "^8.1.1"
  }
}
